<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>windhawk-share</AssemblyName>
    <RootNamespace>WindhawkShare</RootNamespace>
    <Version>0.1.0</Version>

    <!-- Single executable, no need to install .NET on the user's PC -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- JSON uses source generation, so reflection is not needed -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GUI is a separate project in the gui/ folder -->
    <Compile Remove="gui/**" />
    <None Remove="gui/**" />
    <EmbeddedResource Remove="gui/**" />
  </ItemGroup>

</Project>
